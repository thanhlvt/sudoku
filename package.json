{
  "name": "sudoku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "gen": "tsx tools/generate.ts",
    "verify": "tsx tools/verify.ts",
    "assets": "node scripts/make-icons.mjs && capacitor-assets generate --android --iconBackgroundColor \"#2563eb\" --iconBackgroundColorDark \"#2563eb\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#0f172a\"",
    "android:sync": "tsc --noEmit && vite build --mode capacitor && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/gradle.mjs bundleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
